# FlexEdgeAdmin — Environment Variables
# Copy to .env at project root and fill in real values.
# DO NOT commit .env to git.

# ── Flask ─────────────────────────────────────────────────────────────────
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
FLASK_DEBUG=0
PORT=5000

# ── Microsoft Entra ID (Azure AD) ────────────────────────────────────────
# Create an App Registration in Entra ID portal and fill these in.
# Redirect URI: https://your-domain/auth/callback
AZURE_TENANT_ID=REPLACE_WITH_TENANT_UUID
AZURE_CLIENT_ID=REPLACE_WITH_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# ── Database ─────────────────────────────────────────────────────────────
# SQLite database and encryption key (auto-generated on first run)
DATABASE_URL=sqlite:////config/flexedge.db
ENCRYPTION_KEY_FILE=/config/encryption.key

# ── Legacy config paths (only needed during JSON migration) ──────────────
# USERS_CONFIG=/config/users.json
# TENANTS_CONFIG=/config/tenants.json

# ── CLI usage (for docker exec CLI commands) ──────────────────────────────
SMC_API_KEY=REPLACE_WITH_CLI_API_KEY
DEFAULT_TENANT=prod

# ── App branding (optional) ──────────────────────────────────────────────
APP_TITLE=FlexEdgeAdmin

# ── TLS / Production (only needed for docker-compose.prod.yml) ───────────
DOMAIN=admin.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ── Let's Encrypt CRUD (Roadmap item 5 — TLS Manager → /tls/letsencrypt) ─
# Certbot writes under /config/ instead of /etc/letsencrypt/ because the
# Docker image's /etc/letsencrypt/ is root-owned and unwritable by the
# unprivileged gunicorn process. These paths are all subdirectories of
# the existing /config/ bind-mount (see docker/docker-compose.yml), so
# they back up with /admin/backup automatically.
#
# Override only if you need to relocate them (e.g. mounting an external
# volume just for certs). Leave commented for the defaults.
#
# CERTBOT_CONFIG_DIR=/config/letsencrypt
# CERTBOT_WORK_DIR=/config/letsencrypt-work
# CERTBOT_LOGS_DIR=/config/letsencrypt-logs
# CERTBOT_WEBROOT=/config/letsencrypt-webroot
#
# CERTBOT_LIVE_DIR is what the TLS Manager's certbot_reader scans for
# existing certs. Defaults to ${CERTBOT_CONFIG_DIR}/live. Set to the
# legacy /etc/letsencrypt/live ONLY if you have host-mounted certbot
# lineages from a previous deployment outside the container.
# CERTBOT_LIVE_DIR=/etc/letsencrypt/live
